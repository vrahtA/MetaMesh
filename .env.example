# Server Environment Variables
PORT=2567
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/metamesh
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/metamesh?retryWrites=true&w=majority

# Chat Configuration
CHAT_RATE_LIMIT_MAX_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_HISTORY_DEFAULT_LIMIT=50
CHAT_MESSAGE_MAX_LENGTH=1000

# Optional: Message Retention
CHAT_MESSAGE_RETENTION_DAYS=30
